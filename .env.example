# Copy to .env and fill in real values (.env is gitignored — never commit it).
# These feed the `local` Spring profile (src/main/resources/application-local.yml),
# which connects to Oracle Autonomous Database in thin mode using the wallet.

# ─── Oracle Autonomous Database (thin mode, wallet) ───────────────────────────
# Connecting user. We connect as ADMIN and switch CURRENT_SCHEMA to ORACLE_SCHEMA.
ORACLE_USER=ADMIN
ORACLE_PASSWORD=change-me
# DSN = a TNS alias from the wallet's tnsnames.ora (e.g. vodongha_tp / _high).
ORACLE_DSN=vodongha_tp
# Dedicated schema this app owns so several apps can share one ADB. Created once
# by scripts/create_schema.sql. Every connection runs
# `ALTER SESSION SET CURRENT_SCHEMA = TRAVEL_MATE`, so Flyway/JPA use this schema.
ORACLE_SCHEMA=TRAVEL_MATE
# Directory holding the unzipped wallet (cwallet.sso, tnsnames.ora, ...).
# Locally point it at the repo's ./wallet (gitignored).
TNS_ADMIN=./wallet
# Wallet password set when downloading the wallet from OCI. Only needed for the
# JKS keystores; the auto-login SSO wallet (cwallet.sso) connects without it.
WALLET_PASSWORD=change-me

# ─── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=8000

# ─── JWT (used from M2) ───────────────────────────────────────────────────────
# Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
